---
import { SITE } from '../data/site';
const year = new Date().getUTCFullYear();
---

<footer class="site-footer">
  <div class="shell footer-top">
    <div class="footer-identity"><a class="brand" href="/"><span class="brand-mark" aria-hidden="true">U/</span><span class="brand-name">{SITE.name}</span></a><p>Practical tools. Clear methods.<br />No account required.</p><a class="preferred-source-button" href="https://www.google.com/preferences/source?q=utilitas.app" target="_blank" rel="noopener noreferrer" aria-label="Add as preferred source on Google: Utilitas (opens in a new tab)">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true" focusable="false"><path d="m12 3 2.8 5.7 6.3.9-4.5 4.4 1.1 6.2-5.7-3-5.7 3 1.1-6.2L3.2 9.6l6-.9L12 3Z" /></svg>
        <span class="preferred-source-copy"><strong>Add as preferred source</strong><small>on Google</small></span>
      </a></div>
    <div class="footer-column"><p>Use</p><a href="/projects/">Tool index</a><a href="/articles/">Field Notes</a><a href="/about/">About</a></div>
    <div class="footer-column"><p>Trust</p><a href="/privacy/">Privacy</a><a href="/security/">Security</a><a href="/terms/">Terms</a><a href="/access/">Access</a></div>
    <div class="footer-column"><p>Contact</p><a href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a><a href="/contact/">Feedback and support</a><a href="/security/">Report a vulnerability</a><a href="/llms.txt">Machine-readable map</a></div>
  </div>
  <div class="shell footer-bottom"><p>&copy; {year} {SITE.name}</p></div>
</footer>
