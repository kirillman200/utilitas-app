---
interface Props { text: string }
const { text } = Astro.props;
// Support editorial links while leaving all other text escaped by Astro.
const pattern = /\[([^\]]+)\]\((https?:\/\/[^\s)]+|\/(?!\/)[^\s)]*)\)/g;
const parts: Array<{ text: string; href?: string }> = [];
let offset = 0;
for (const match of text.matchAll(pattern)) {
  parts.push({ text: text.slice(offset, match.index) });
  parts.push({ text: match[1], href: match[2] });
  offset = match.index + match[0].length;
}
parts.push({ text: text.slice(offset) });
---
{parts.map((part) => part.href ? <a href={part.href}>{part.text}</a> : part.text)}
